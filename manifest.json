{
  "manifest_version": 3,
  "name": "VTOP Modern - Academic Companion",
  "version": "1.1.0",
  "description": "Studio-grade redesign for VTOP with exact 75% attendance calculations, academic privacy shield, timetable assistant, and Raycast-style command menu.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "VTOP Modern Control Center"
  },
  "permissions": [
    "storage"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "vtop-modern@vit.ac.in",
      "strict_min_version": "109.0"
    }
  },
  "host_permissions": [
    "*://vtopcc.vit.ac.in/*",
    "*://vtop.vit.ac.in/*",
    "*://vtop2.vit.ac.in/*",
    "*://vtopbhopal.vit.ac.in/*",
    "*://vtop.vitap.ac.in/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://vtopcc.vit.ac.in/*",
        "*://vtop.vit.ac.in/*",
        "*://vtop2.vit.ac.in/*",
        "*://vtopbhopal.vit.ac.in/*",
        "*://vtop.vitap.ac.in/*"
      ],
      "css": [
        "styles/theme.css",
        "styles/login.css",
        "styles/dashboard.css",
        "styles/attendance.css",
        "styles/command-palette.css"
      ],
      "js": [
        "scripts/icons.js",
        "scripts/theme-manager.js",
        "scripts/login-helper.js",
        "scripts/attendance.js",
        "scripts/timetable.js",
        "scripts/command-palette.js",
        "scripts/content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["icons/*", "styles/*"],
      "matches": [
        "*://vtopcc.vit.ac.in/*",
        "*://vtop.vit.ac.in/*",
        "*://vtop2.vit.ac.in/*",
        "*://vtopbhopal.vit.ac.in/*",
        "*://vtop.vitap.ac.in/*"
      ]
    }
  ]
}
